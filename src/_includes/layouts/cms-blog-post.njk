<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ post.seoDescription or post.description or site.description }}">
    <link rel="canonical" href="{{ site.url ~ page.url }}">
    <link rel="icon" type="image/png" sizes="180x180" href="/icons/favicon-180.png">

    {% set pageTitle = (post.seoTitle or post.title) ~ " | " ~ site.name %}
    {% set pageDescription = post.seoDescription or post.description or site.description %}
    {% set ogImage = site.url ~ (post.featuredImage or site.defaultOgImage) %}
    {% set ogWidth = post.featuredImageWidth or 1200 %}
    {% set ogHeight = post.featuredImageHeight or 630 %}

    <meta property="og:type" content="article">
    <meta property="og:locale" content="en_AU">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:url" content="{{ site.url ~ page.url }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{ ogImage }}">
    <meta property="og:image:width" content="{{ ogWidth }}">
    <meta property="og:image:height" content="{{ ogHeight }}">
    <meta property="og:image:alt" content="{{ post.title }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ ogImage }}">

    <title>{{ pageTitle }}</title>

    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Blog Feed" href="{{ site.url }}/blog/feed.xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&amp;family=Roboto:wght@400;500&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/tailwind-build.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/blog.css">
    <script src="https://unpkg.com/smoothscroll-polyfill@0.4.4/dist/smoothscroll.min.js"></script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ post.title | jsonStringify | safe }},
      "description": {{ pageDescription | jsonStringify | safe }},
      "image": {{ ogImage | jsonStringify | safe }},
      "datePublished": {{ (post.date | dateToISO) | jsonStringify | safe }},
      "mainEntityOfPage": {{ (site.url ~ page.url) | jsonStringify | safe }},
      "author": {
        "@type": "Person",
        "name": "Matt Milzewski"
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ site.name | jsonStringify | safe }},
        "url": {{ (site.url ~ "/") | jsonStringify | safe }}
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Home","item":{{ (site.url ~ "/") | jsonStringify | safe }}},
        {"@type":"ListItem","position":2,"name":"Blog","item":{{ (site.url ~ "/blog/") | jsonStringify | safe }}},
        {"@type":"ListItem","position":3,"name":{{ post.title | jsonStringify | safe }},"item":{{ (site.url ~ page.url) | jsonStringify | safe }}}
      ]
    }
    </script>
</head>
<body class="bg-sand-beige text-dark-text font-roboto">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-anchor-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">Skip to main content</a>
    {% include "header.njk" %}

    <nav class="breadcrumbs" aria-label="Breadcrumb"><div class="container"><ol><li><a href="/">Home</a></li><li><a href="/blog/">Blog</a></li><li aria-current="page">{{ post.title }}</li></ol></div></nav>

    <main id="main-content" class="section-pad" style="padding-top: 56px;">
        <div class="container mx-auto px-4">
            <article class="blog-post" style="max-width: 720px; margin: 0 auto;">
                <p class="blog-post__meta">
                    <time datetime="{{ post.date | dateToISO }}">{{ post.date | readableDate }}</time>
                </p>
                <h1 class="display blog-post__title">{{ post.title }}</h1>
                {% if post.description %}
                <p class="blog-post__lede">{{ post.description }}</p>
                {% endif %}
                {% if post.featuredImage %}
                <div class="blog-post__image-wrap">
                    <img class="blog-post__image" src="{{ post.featuredImage }}" alt="{{ post.title }}">
                </div>
                {% endif %}
                <div class="blog-content body-lg">
                    {{ post.body | safe }}
                </div>
            </article>
        </div>
    </main>

    {% include "footer.njk" %}
    <script src="/js/main.js" defer></script>
</body>
</html>
