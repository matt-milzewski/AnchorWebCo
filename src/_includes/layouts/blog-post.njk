<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url ~ page.url }}">
    <link rel="icon" type="image/png" sizes="180x180" href="/icons/favicon-180.png">

    {% set pageTitle = title ~ " | " ~ site.name %}
    {% set pageDescription = description or site.description %}
    {% set ogImage = site.url ~ (featuredImage or site.defaultOgImage) %}
    {% set ogWidth = featuredImageWidth or 1200 %}
    {% set ogHeight = featuredImageHeight or 630 %}

    <meta property="og:type" content="article">
    <meta property="og:locale" content="en_AU">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:url" content="{{ site.url ~ page.url }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{ ogImage }}">
    <meta property="og:image:width" content="{{ ogWidth }}">
    <meta property="og:image:height" content="{{ ogHeight }}">
    <meta property="og:image:alt" content="{{ title }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ ogImage }}">

    <title>{{ pageTitle }}</title>

    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Blog Feed" href="{{ site.url }}/blog/feed.xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&amp;family=Roboto:wght@400;500&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/tailwind-build.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/blog.css">
    <script src="https://unpkg.com/smoothscroll-polyfill@0.4.4/dist/smoothscroll.min.js"></script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | jsonStringify | safe }},
      "description": {{ pageDescription | jsonStringify | safe }},
      "image": {{ ogImage | jsonStringify | safe }},
      "datePublished": {{ (date | dateToISO) | jsonStringify | safe }},
      "mainEntityOfPage": {{ (site.url ~ page.url) | jsonStringify | safe }},
      "author": {
        "@type": "Person",
        "name": "Matt Milzewski"
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ site.name | jsonStringify | safe }},
        "url": {{ (site.url ~ "/") | jsonStringify | safe }}
      }
    }
    </script>
</head>
<body class="bg-sand-beige text-dark-text font-roboto">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-anchor-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">Skip to main content</a>
    {% include "header.njk" %}

    <main id="main-content" class="section-pad" style="padding-top: 140px;">
        <div class="container mx-auto px-4">
            <article class="blog-post" style="max-width: 720px; margin: 0 auto;">
                <p class="blog-post__meta">
                    <time datetime="{{ date | dateToISO }}">{{ date | readableDate }}</time>
                </p>
                <h1 class="display blog-post__title">{{ title }}</h1>
                {% if description %}
                <p class="blog-post__lede">{{ description }}</p>
                {% endif %}
                {% if featuredImage %}
                <div class="blog-post__image-wrap">
                    <img class="blog-post__image" src="{{ featuredImage }}" alt="{{ title }}">
                </div>
                {% endif %}
                <div class="blog-content body-lg">
                    {{ content | safe }}
                </div>
            </article>
        </div>
    </main>

    {% include "footer.njk" %}
    <script src="/js/main.js" defer></script>
</body>
</html>
